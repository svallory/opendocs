{
  "name": "@opendocs/model",
  "version": "0.1.0",
  "description": "Universal documentation model for OpenDocs - language-agnostic API documentation representation",
  "keywords": [
    "opendocs",
    "documentation",
    "api",
    "model",
    "docitem"
  ],
  "author": "Saulo Vallory",
  "license": "MIT",
  "repository": "https://github.com/svallory/opendocs",
  "dependencies": {
    "ajv": "^8.12.0"
  },
  "packemon": {
    "format": "lib",
    "platform": "node"
  },
  "engines": {
    "node": ">=16.12.0",
    "npm": ">=6.14.0"
  },
  "files": [
    "lib/**/*",
    "src/**/*"
  ],
  "types": "./lib/index.d.ts",
  "main": "./lib/index.js",
  "exports": {
    "./package.json": "./package.json",
    "./*": {
      "types": "./lib/*.d.ts",
      "node": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      },
      "default": "./lib/*.js"
    },
    ".": {
      "types": "./lib/index.d.ts",
      "node": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "default": "./lib/index.js"
    }
  }
}
